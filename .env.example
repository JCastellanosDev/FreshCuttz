# Variables de entorno para Vercel (Settings → Environment Variables).
# En XAMPP no hacen falta: sin ellas se usa root@127.0.0.1/freshcuttz.
DB_HOST=
DB_PORT=3306
DB_NAME=freshcuttz
DB_USER=
DB_PASSWORD=
# 1 = conexión cifrada (obligatoria en Aiven, TiDB Cloud, Railway…)
DB_SSL=1
# Opcional: ruta a un certificado CA propio del proveedor. Por defecto usa los del sistema.
DB_SSL_CA=
